{
  "name": "@necromancer/crew-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Necromancer Kiro Crew app: Graveyard page, Night Watch job, agent, skill and MCP server.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "check": "npm run typecheck && npm test",
    "bundle:mcp": "node scripts/build-mcp.mjs",
    "bundle:ui": "npm --prefix ui run build",
    "bundle": "npm run bundle:mcp && npm run bundle:ui",
    "build": "npm run bundle",
    "export": "node scripts/export-repo.mjs",
    "verify:export": "node scripts/verify-export.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@necromancer/engine": "file:../../packages/engine",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.2.0",
    "esbuild": "^0.28.2",
    "fast-check": "^4.0.0",
    "jsdom": "^28.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.0",
    "vitest": "^5.1.0"
  }
}
